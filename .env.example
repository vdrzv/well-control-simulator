# Public origin used to build exact OAuth callback URLs in production.
# For the bundled local launcher use http://127.0.0.1:8001.
PUBLIC_BASE_URL=http://127.0.0.1:8001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Enable in production when the site is served over HTTPS.
COOKIE_SECURE=false
